desc "deploy clickearthonline"
lane :clickearthonline do

    gradle(
        task: 'bundle',
        flavor: "CLICKEARTHONLINE",
        build_type: 'Release')

    AAB_LOCATION = "#{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}"

    copy_artifacts(
        artifacts: [AAB_LOCATION],
        target_path: '~/Desktop/'
    )

    supply(
        track: 'production',
        package_name: 'com.softifybd.clickearthonline',
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_metadata: true,
        skip_upload_apk: true,
        aab: AAB_LOCATION
    )
end


