  #start
    desc "deploy each flavor"
    lane :ispdigitalpaid do

    gradle(
            task: 'bundle',
            flavor: "ispdigitalPaid",
            build_type: 'Release')

    AAB_LOCATION = "#{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}"

    copy_artifacts(
            artifacts: [AAB_LOCATION],
            target_path: '~/Desktop/'
    )

    supply(
            track: 'production',
            package_name: 'com.softifybd.ispdigital',
            skip_upload_images: true,
            skip_upload_screenshots: true,
            skip_upload_metadata: true,
            skip_upload_apk: true,
            apk: AAB_LOCATION
    )
    end

